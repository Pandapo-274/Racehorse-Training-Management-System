# Copy this file to ".env" (same folder) and replace the placeholder values.
# Do NOT put quotes around values and do NOT put comments after a value (they become part of the value).
# ".env" is git-ignored. Never commit real passwords or keys. Only commit this ".env.example".

# ---- Database (your own local SQL Server) ----
DB_HOST=Your Host Here
DB_PORT=Your Port Here
DB_NAME=Your Database Name Here
DB_USERNAME=Your Database Username Here
DB_PASSWORD=Your Database Username Password Here

# ---- Auth ----
# Every developer generates their own secret (at least 32 characters). Generate it with PowerShell:
# $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=Your JWT_SECRET KEY HERE

# ---- Google login ----
# Not a secret. Ask the project owner. The SAME value must be set in frontend/.env as REACT_APP_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=Your Google Client ID Here

# ---- Reset-password email ----
# false = do not send email, print the reset link in the backend console instead (recommended for local dev).
MAIL_ENABLED=false
# Only needed when MAIL_ENABLED=true. Use a Gmail App Password (16 characters, no spaces), never the real Gmail password.
MAIL_USERNAME=
MAIL_PASSWORD=